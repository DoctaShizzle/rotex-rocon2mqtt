{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Process", "Serilog.Enrichers.Thread" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "RoconMqtt": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentUserName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "192.168.0.254",
    "Port": 1883,
    "UseTls": false,
    "ValidateCertificate": false,
    "ClientId": "rocon-publisher",
    "Username": "rocon",
    "Password": "045ef95d",
    "KeepAlivePeriodSeconds": 30,
    "Topic": "rocon",
    "ChangeThresholdPercent": 2.0,
    "TimeZoneId": "Europe/Brussels",
    "PollingIntervalSeconds": 30,
    "ResponseTimeoutSeconds": 5,
    "HomeAssistant": {
      "Discovery": true,
      "DiscoveryPrefix": "homeassistant",
      "DeviceIdentifierFormat": "rocon_{deviceType}_{deviceId}",
      "ObjectIdentifierFormat": "rocon_{deviceType}_{deviceId}_{objectId}",
      "DeviceNameFormat": "Rotex {deviceType} {deviceId}",
      "DeviceManufacturer": "Rotex",
      "DeviceModel": "Rotex",
      "DeviceSoftwareVersion": "1.0",
      "ValueTemplate": "{{ value_json.Value }}",
      "UniqueIdFormat": "rocon_{deviceType}_{deviceId}_{parameterName}",
      "ObjectIdFormat": "rocon_{deviceType}_{deviceId}_{parameterName}"
    }
  },
  "Can": {
    "MachineType": "EHSHXXPXXA",
    "CanInterfaceName": "can0",
    "TimeZoneId": "Europe/Brussels"
  },
  "Resilience": {
    "Enabled": true,
    "RetryCount": 3,
    "BaseRetryDelayMs": 500,
    "CircuitBreakerFailureThreshold": 3,
    "CircuitBreakerDurationSeconds": 60
  }
}
