{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Seq", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Process", "Serilog.Enrichers.Thread" ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "RoconMqtt": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      /*{
        "Name": "File",
        "Args": {
          "path": "logs/rocon-mqtt-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },*/
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://192.168.0.254:5341"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithEnvironmentUserName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5000"
      }
    }
  },
  "Mqtt": {
    "Enabled": true,
    "Host": "192.168.0.254",
    "Port": 1883,
    "UseTls": false,
    "ValidateCertificate": false,
    "ClientId": "rocon-publisher",
    "Username": "rocon",
    "Password": "045ef95d",
    "KeepAlivePeriodSeconds": 30,
    "Topic": "rocon",
    "ChangeThresholdPercent": 2.0,
    "TimeZoneId": "Europe/Brussels",
    "Devices": [
      "HG1"
    ],
    "Parameters": [
      "DeviceIdentifier",
      "OutdoorTemperature",
      "BufferTemperatureActual",
      "BufferTemperatureSetpointAdjusted",
      "BufferTemperatureSetpoint",
      "HotWaterProductionActive",
      "RoomTemperatureActual",
      "RoomTemperatureSetpointAdjusted",
      "RoomTargetTemperature1",
      "HeaterTemperatureActual",
      "HeaterTemperatureSetpoint",
      "TR",
      "V",
      "n",
      "ValveCH_DHW",
      "ValveCH_Bypass",
      "TVBH1",
      "TVBHMIX",
      "Defrost",
      "PumpOperatingHours",
      "CompressorOperatingHours",
      "WeatherDependentCurveSetting",
      "LeavingWaterTemperatureSetpoint",
      "LeavingWaterTemperatureActual",
      "CurrentError"
    ],
    "CompoundParameters": [
      "Timestamp"
    ],
    "PollingIntervalSeconds": 30,
    "ResponseTimeoutSeconds": 5,
    "HomeAssistant": {
      "Discovery": true,
      "DiscoveryPrefix": "homeassistant",
      "DeviceIdentifierFormat": "rocon_{deviceId}",
      "ObjectIdentifierFormat": "rocon_{deviceId}_{objectId}",
      "DeviceNameFormat": "Rotex Device {deviceId}",
      "DeviceManufacturer": "Rotex",
      "DeviceModel": "Rotex",
      "DeviceSoftwareVersion": "1.0",
      "ValueTemplate": "{{ value_json.Value }}",
      "UniqueIdFormat": "rocon_{deviceId}_{parameterName}",
      "ObjectIdFormat": "rocon_{deviceId}_{parameterName}"
    }
  },
  "Can": {
    "CanInterfaceName": "can0",
    "TimeZoneId": "Europe/Brussels"
    /*"Ssh": {
      "Host": "192.168.0.250",
      "Port": 22,
      "Username": "root",
      "Password": "temppwd"
    }*/
  },
  "Resilience": {
    "Enabled": true,
    "RetryCount": 3,
    "BaseRetryDelayMs": 500,
    "CircuitBreakerFailureThreshold": 3,
    "CircuitBreakerDurationSeconds": 60
  }
}
