{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "RoconMqtt": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rocon-mqtt-.txt",
          "rollingInterval": "Day",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ]
  },
  "Mqtt": {
    "Host": "192.168.0.254",
    "Port": 1883,
    "ClientId": "rocon-publisher",
    "Username": "rocon",
    "Password": "045ef95d-d4bd-45dd-8a46-3dd230aa69fc",
    "Topic": "rocon/telemetry",
    "Devices": [
      "HG1"
    ],
    "Parameters": [
      "cAUSSENTEMP",
      "cTAG",
      "cMONAT"
    ],
    "PollingIntervalMs": 5000,
    "ResponseTimeoutMs": 1000
  },
  "Can": {
    "receiveFromCanFrameId": "0x180",
    "receiveToCanFrameId": "0x187",
    "sendCanFrameId": "0x69D"
  }
}
