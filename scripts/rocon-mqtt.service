[Unit]
Description=RoconMqtt - ROCON to MQTT Bridge
After=network.target

[Service]
Type=simple
User=rocon
WorkingDirectory=/opt/rocon-mqtt
ExecStart=/opt/rocon-mqtt/run-production.sh
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security options
NoNewPrivileges=true
PrivateTmp=true

# Environment variables
Environment="ASPNETCORE_ENVIRONMENT=Production"

[Install]
WantedBy=multi-user.target
