# ===========================
# RoconMqtt Environment Configuration
# ===========================
# Copy this file to .env and fill in your actual values.
# The .env file is read by docker-compose automatically.
# For Balena deployment, set these as Fleet or Device environment variables in balenaCloud dashboard.

# ===========================
# Application Environment
# ===========================
ASPNETCORE_ENVIRONMENT=Production

# ===========================
# Kestrel Web Server
# ===========================
KESTREL_URL=http://0.0.0.0:5000

# ===========================
# CAN Configuration
# ===========================
# Machine type (determines which can-registry-{type}.json to load)
# Options: EHSHXXPXXA, EHBHXXPXXA, EHVXXPXXA, etc.
CAN_MACHINE_TYPE=EHSHXXPXXA

# Local CAN interface name (default: can0)
CAN_INTERFACE=can0

# Timezone for CAN compound parameter timestamps (IANA format)
CAN_TIMEZONE=Europe/Brussels

# ===========================
# CAN SSH Configuration (Optional)
# ===========================
# For remote CAN access via SSH. Leave empty to use local SocketCAN.
CAN_SSH_HOST=
CAN_SSH_PORT=22
CAN_SSH_USERNAME=
CAN_SSH_PASSWORD=

# ===========================
# MQTT Broker Configuration
# ===========================
MQTT_ENABLED=true
MQTT_HOST=192.168.0.254
MQTT_PORT=1883
MQTT_USE_TLS=false
MQTT_VALIDATE_CERT=true

# MQTT authentication
MQTT_CLIENT_ID=rocon-mqtt
MQTT_USERNAME=rocon
MQTT_PASSWORD=your-mqtt-password-here

# MQTT connection settings
MQTT_KEEP_ALIVE=30
MQTT_TOPIC=rocon

# ===========================
# MQTT Publishing Settings
# ===========================
# Polling interval: how often to query CAN parameters (seconds)
MQTT_POLLING_INTERVAL=30

# Response timeout: how long to wait for CAN response (seconds)
MQTT_RESPONSE_TIMEOUT=5

# Change threshold: only publish if value changes by this percentage (0-100)
MQTT_CHANGE_THRESHOLD=2.0

# Timezone for MQTT timestamps (IANA format)
MQTT_TIMEZONE=Europe/Brussels

# ===========================
# Home Assistant MQTT Discovery
# ===========================
HA_DISCOVERY=true
HA_DISCOVERY_PREFIX=homeassistant
